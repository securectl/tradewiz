        <mxCell id="re7" style="endArrow=classic;html=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366" edge="1" parent="1" source="openrouter" target="f-skills"><mxGeometry relative="1" as="geometry"/></mxCell>

