  <!-- ═══════════════════════════════════════════════════════════════════
       PAGE 4 — Physical Data Model (key tables, columns, FKs)
       ═══════════════════════════════════════════════════════════════════ -->
  <diagram id="physical-model" name="4. Physical Data Model">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" pageWidth="1500" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t-4" value="Physical Data Model — Key Tables (Postgres + SQLite parity)" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="30" as="geometry"/>
        </mxCell>

        <!-- users -->
        <mxCell id="tab-users" value="users" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="320" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="tab-users-cols" value="PK  id (SERIAL / INTEGER)&#10;UQ  email TEXT NOT NULL&#10;       name TEXT&#10;       google_id TEXT&#10;       picture_url TEXT&#10;       password_hash TEXT&#10;       totp_secret TEXT (encrypted)&#10;       is_locked BOOLEAN DEFAULT false&#10;       created_at TIMESTAMP&#10;       last_login TIMESTAMP&#10;&#10;Sentinel: id=0 = global bot defaults" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="300" height="180" as="geometry"/>
        </mxCell>

        <!-- bot_trades (the core) -->
        <mxCell id="tab-trades" value="bot_trades  ⟵  PRIMARY TRADE LEDGER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="380" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="tab-trades-cols" value="PK   id  SERIAL&#10;FK   user_id → users(id) ON DELETE CASCADE&#10;        coin TEXT  (ticker for stocks)&#10;        side TEXT  (buy / sell / long / short)&#10;        size REAL&#10;        entry_price REAL&#10;        exit_price REAL  (NULL when open)&#10;        pnl REAL · pnl_pct REAL · fee REAL&#10;        status TEXT  (open / closed / killed)&#10;        signal_reason TEXT · validation_result TEXT(json)&#10;        stop_loss REAL · take_profit REAL&#10;        opened_at TIMESTAMP · closed_at TIMESTAMP&#10;        blofin_order_id TEXT · strategy TEXT&#10;        asset_type TEXT  ⟵  crypto / stock / claude / watchdog&#10;        direction_bias TEXT · regime_at_entry TEXT&#10;&#10;IDX  (user_id, status, asset_type)&#10;IDX  (user_id, closed_at) WHERE status='closed'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="410" y="110" width="360" height="240" as="geometry"/>
        </mxCell>

        <!-- bot_config -->
        <mxCell id="tab-cfg" value="bot_config  (per-user knobs · user_id=0 = global)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="320" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="tab-cfg-cols" value="PK   (user_id, key)&#10;FK   user_id → users(id) ON DELETE CASCADE&#10;        key   TEXT     e.g. cb_mode, cb_broker,&#10;                       cb_take_profit_pct, wd_enabled&#10;        value TEXT     stringly typed&#10;&#10;Resolver: ORDER BY CASE WHEN user_id = 0&#10;          THEN 1 ELSE 0 END LIMIT 1&#10;          → user value wins, falls back to&#10;            global (sentinel id=0), then code default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="830" y="110" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- user_api_keys -->
        <mxCell id="tab-keys" value="user_api_keys  (encrypted broker / LLM creds)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1180" y="80" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="tab-keys-cols" value="PK   id&#10;UQ   (user_id, provider, key_name)&#10;FK   user_id → users(id) CASCADE&#10;        provider  TEXT (alpaca|webull|blofin|openrouter)&#10;        key_name  TEXT (api_key|secret_key|app_key|...)&#10;        encrypted_value TEXT (Fernet)&#10;        updated_at TIMESTAMP&#10;&#10;Read via: shared.helpers.get_user_api_keys()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1190" y="110" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- screener_results -->
        <mxCell id="tab-screener" value="screener_results  (multi-day scan history)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="320" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="tab-screener-cols" value="PK   id  SERIAL&#10;        category   TEXT  (lowcap|midcap|largecap|...)&#10;        scan_date  TEXT  (YYYY-MM-DD)&#10;        ticker     TEXT&#10;        verdict    TEXT&#10;        confidence REAL  0-100&#10;        summary    TEXT&#10;        sector     TEXT · name TEXT&#10;        market_cap NUMERIC · price REAL&#10;        data_json  TEXT&#10;&#10;Watchdog reads ≥2 daily appearances&#10;→ tags as &quot;PERSISTENT-Nd&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="50" y="350" width="300" height="160" as="geometry"/>
        </mxCell>

        <!-- bot_log -->
        <mxCell id="tab-log" value="bot_log  (per-bot activity stream)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="380" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="tab-log-cols" value="PK   id&#10;FK   user_id → users(id) CASCADE&#10;        level    TEXT  (info|warn|error)&#10;        message  TEXT  (max 500)&#10;        details  TEXT  (json)&#10;        source   TEXT  (crypto|stock|claude|watchdog|options_flow)&#10;        created_at TIMESTAMP&#10;&#10;Cleaned to last 7 days on _startup_cleanup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="410" y="410" width="360" height="120" as="geometry"/>
        </mxCell>

        <!-- journal_entries -->
        <mxCell id="tab-journal" value="journal_entries  (manual notes only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="820" y="280" width="320" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="tab-journal-cols" value="PK   id&#10;FK   user_id → users(id) CASCADE&#10;        ticker TEXT&#10;        action TEXT (BUY|SELL)&#10;        entry_price REAL · exit_price REAL&#10;        shares REAL · pnl REAL · notes TEXT&#10;        created_at TIMESTAMP&#10;&#10;/api/journal filters out notes LIKE &apos;[%Bot]%&apos;&#10;to hide legacy bot-auto-logged rows&#10;(bots no longer write here as of Apr 2026)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="830" y="310" width="300" height="140" as="geometry"/>
        </mxCell>

        <!-- bot_daily_pnl -->
        <mxCell id="tab-pnl" value="bot_daily_pnl  (rolled-up daily totals)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1180" y="280" width="280" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="tab-pnl-cols" value="UQ   (user_id, date)&#10;FK   user_id → users(id) CASCADE&#10;        date            DATE&#10;        total_pnl       REAL&#10;        trade_count     INT&#10;        win_count       INT&#10;        loss_count      INT&#10;&#10;Updated by bot engines after each close.&#10;Powers /api/bot/dashboard period summaries." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1190" y="310" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- searches -->
        <mxCell id="tab-search" value="searches" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="320" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="tab-search-cols" value="PK   id&#10;FK   user_id → users(id) CASCADE&#10;        ticker TEXT&#10;        period TEXT · interval_val TEXT&#10;        result_json TEXT  (analysis cache)&#10;        created_at TIMESTAMP · expires_at TIMESTAMP&#10;&#10;3-day TTL · powers analysis history sidebar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- llm_usage_log -->
        <mxCell id="tab-llmlog" value="llm_usage_log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="380" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="tab-llmlog-cols" value="PK   id&#10;FK   user_id → users(id) CASCADE&#10;        call_source TEXT (analyze|validate|predict|...)&#10;        call_count  INT&#10;        model       TEXT · tokens INT · cost_usd NUMERIC&#10;        created_at  TIMESTAMP&#10;&#10;Cleaned to last 30 days at _startup_cleanup&#10;Per-tier rate limits read this for quota gates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="410" y="590" width="360" height="130" as="geometry"/>
        </mxCell>

        <!-- watchdog snapshots -->
        <mxCell id="tab-wd" value="watchdog_snapshots / signals / paper_trades" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="820" y="500" width="320" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="tab-wd-cols" value="snapshots:  composite regime score by minute&#10;signals:    BUY/HEDGE/SELL/WATCH/AVOID rows&#10;            ticker, signal, confidence, reasoning&#10;paper_trades: legacy table (replaced by&#10;            bot_trades with asset_type=&apos;watchdog&apos;)&#10;&#10;Note: actual day-trader trades go into&#10;      bot_trades — these are scan history." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="830" y="530" width="300" height="140" as="geometry"/>
        </mxCell>

        <!-- non-user system tables -->
        <mxCell id="tab-sys" value="System tables  (no user FK — global)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1180" y="500" width="280" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="tab-sys-cols" value="invites          PK email · role · bot_access&#10;service_checks   service_name · status · checked_at&#10;service_incidents started_at · resolved_at&#10;trump_mood_history    daily mood rows&#10;trump_market_predictions&#10;trump_backtracks · trump_forecast_weights&#10;whale_entities · whale_holdings · whale_activity&#10;trial_fingerprints      anti-abuse&#10;oversold_daily          persistent oversold cache&#10;backtest_runs           strategy backtest results" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1190" y="530" width="260" height="150" as="geometry"/>
        </mxCell>

        <!-- FK arrows -->
        <mxCell id="fk-1" style="endArrow=open;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2" edge="1" parent="1" source="tab-users" target="tab-trades">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fk-2" style="endArrow=open;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450" edge="1" parent="1" source="tab-users" target="tab-cfg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fk-3" style="endArrow=open;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366" edge="1" parent="1" source="tab-users" target="tab-search">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="legend-4" value="Color key:  blue = identity · red = bot trade core · green = analysis/journal · yellow = market data · purple = system" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1400" height="20" as="geometry"/>
