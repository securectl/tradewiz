        <mxCell id="an-l1" value="Model A — Research&#10;LLM_RESEARCH (Claude Sonnet 4-6)&#10;or LLM_RESEARCH_FAST (Gemini Flash) in fast mode&#10;&#10;Input: company info · sector · regime ·&#10;fundamentals (cash/debt/FCF) · news 24h ·&#10;active catalysts ↑↓ tags&#10;&#10;Output: thesis · risks · catalysts · grade A-D" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
