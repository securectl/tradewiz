        <mxCell id="re-10" value="1:N" style="endArrow=classic;html=1;startArrow=classicThin;strokeColor=#666" edge="1" parent="1" source="ent-user" target="ent-journal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re-11" value="1:N" style="endArrow=classic;html=1;startArrow=classicThin;strokeColor=#666" edge="1" parent="1" source="ent-user" target="ent-goal"><mxGeometry relative="1" as="geometry"/></mxCell>
