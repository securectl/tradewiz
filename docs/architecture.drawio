        <!-- PATTERN -->
        <mxCell id="an-pat" value="STAGE 3 — PATTERN DETECTION (swing-based)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1420" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="an-p1" value="3a. Swing point detection&#10;find_swing_highs / find_swing_lows&#10;Local extrema with N-bar lookback (default 5)&#10;Filters out micro-noise" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="an-p2" value="3b. Trendline fitting (fit_trendline)&#10;Linear regression on last 2 swing points&#10;Returns: (slope, intercept, R²)&#10;Validation: no candle pierces between anchor points&#10;construct_validated_trendline()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="500" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="an-p3" value="3c. Pattern classification&#10;• Sloped trendline + flat support → ascending triangle&#10;• Symmetrical converging → triangle / pennant&#10;• Higher highs + higher lows → uptrend channel&#10;• Tight range &lt; 5% → consolidation / VCP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="800" y="500" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="an-p4" value="3d. Confidence score&#10;0-100 from:&#10;• upper R² · lower R²&#10;• swing count (more = stronger)&#10;• consolidation tightness&#10;• volume profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1140" y="500" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="an-p5" value="3e. Breakout level + price target + stop-loss&#10;breakout_level = upper trendline at current bar (or 20-day high if rangy)&#10;pattern_height = breakout_level - support_level&#10;price_target = breakout_level + pattern_height (1:1 measured-move)&#10;stop_loss = support_level - 1×ATR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="595" width="700" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="an-p6" value="3f. Risk/Reward&#10;R:R = (target - breakout) / (breakout - stop)&#10;≥ 2:1 = solid setup&#10;≥ 3:1 = grade A&#10;&lt; 1:1 = skip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="780" y="595" width="320" height="100" as="geometry"/>
