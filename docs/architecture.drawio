        <mxCell id="sb-sub" value="stock_bot/stock_engine.py · stock_trade_mode = scalp | swing | hybrid · stock_scan_interval default 300s" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=11;fontStyle=2" vertex="1" parent="1">
