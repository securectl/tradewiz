  </diagram>


  <!-- ═══════════════════════════════════════════════════════════════════
       PAGE 5 — Bot Trade Flow (one cycle, end-to-end)
       ═══════════════════════════════════════════════════════════════════ -->
  <diagram id="trade-flow" name="5. Bot Trade Flow">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" pageWidth="1500" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t-5" value="Bot Scan-to-Execution Flow (per bot, per cycle)" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="30" as="geometry"/>
        </mxCell>

        <!-- Steps -->
        <mxCell id="s-trigger" value="1. Trigger&#10;Auto-trader thread sleeps&#10;cb_scan_interval (default 300s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-precheck" value="2. Pre-flight checks&#10;• kill_switch on?&#10;• daily_loss_limit breached?&#10;• inside buy window? (Watchdog 9:30-11 ET)&#10;• regime DANGER → skip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-universe" value="3. Build candidate universe&#10;• static watchlist (bot_config.wd_watchlist)&#10;• screener candidates (≥2 days persist)&#10;• large-cap qullamaggie (score ≥ 7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-data" value="4. Fetch market data&#10;yfinance batch download (period=1y)&#10;skip tickers missing from batch (delisted)&#10;regime score cached 30m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="940" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-signal" value="5. Signal generation&#10;_detect_swing_setup() per ticker&#10;Volume + RSI + MACD + ATR&#10;Strategies: VCP / HTF / Breakout / RSI Reversal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Row 2 -->
        <mxCell id="s-llm" value="6. LLM vetting&#10;_llm_vet_watchdog_candidate() (parallel via ThreadPoolExecutor)&#10;Uses LLM_RESEARCH model · regime + setup + screener data → approve/skip&#10;Cached so retries hit warm decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="500" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-blacklist" value="7. Self-learning gate&#10;Strategy in blacklisted_strategies?&#10;(perm: ema_trend; auto: n≥10 + WR&lt;25% + net&lt;0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="600" y="220" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-risk" value="8. Risk gates&#10;max_positions · max_position_pct · already_holding?&#10;has_pdt? (stocks) · market_hours? · price plausible?&#10;sanity guardrail: |mark/entry-1| &gt; 1.0 → reject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="960" y="220" width="500" height="80" as="geometry"/>
        </mxCell>

        <!-- Row 3 - execution -->
        <mxCell id="s-broker" value="9. Resolve broker&#10;_get_broker(user_id) → reads cb_broker, cb_mode&#10;Loads encrypted user_api_keys for that provider&#10;Falls back to env vars if user keys missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-size" value="10. Position sizing&#10;equity × max_position_pct × size_factor&#10;shares = max(1, target_usd / price)&#10;(int rounding — fractional not yet supported)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="480" y="340" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-place" value="11. Place order&#10;BloFin client (crypto) / Alpaca / Webull (stocks)&#10;paper=True default · paper=False if cb_mode=&apos;live&apos;&#10;Returns order_id or PAPER-LOCAL fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="900" y="340" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-write" value="12. Persist&#10;INSERT bot_trades&#10;UPDATE bot_daily_pnl&#10;_log() → bot_log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1320" y="340" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- Row 4 - exits (separate path running every cycle) -->
        <mxCell id="exits-band" value="EXIT CHECK (runs every cycle alongside entries)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="1400" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="x-1" value="EOD force-close&#10;15:55 ET weekday&#10;(Watchdog only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="80" y="495" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="x-2" value="Stop-loss / TP&#10;cb_hard_stop_pct, cb_take_profit_pct&#10;trailing stop (50% retrace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="280" y="495" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="x-3" value="48h hard hold cap&#10;regardless of P&amp;L&#10;(prevents capital lockup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="495" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="x-4" value="RSI overbought lock-in&#10;RSI &gt; 60 + profit &gt; 0.5%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="740" y="495" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="x-5" value="Implausible-price guard&#10;|mark/entry−1| &gt; 1.0&#10;reject close, retry next cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="960" y="495" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="x-6" value="Manual close button&#10;(per-trade UI control)&#10;sanity guard same as auto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1200" y="495" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- Row 5 - tracker / dashboard -->
        <mxCell id="dash-band" value="POST-TRADE: surfaced to user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="1400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="d-1" value="Tracker tab&#10;/api/tracker/bot-trades&#10;source filter (crypto/stock/claude/watchdog)&#10;overall scopes to filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d-2" value="Bot dashboard&#10;/api/bot/dashboard?asset=...&#10;period summaries · streaks · daily goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="380" y="640" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d-3" value="Open trades panel&#10;Close button + live unrealized P&amp;L&#10;(yfinance fast_info batched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="680" y="640" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d-4" value="bot_log → activity feed&#10;Admin export CSV&#10;(admin-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="980" y="640" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d-5" value="Self-learning loop&#10;reads last 14d closed trades&#10;updates blacklist + position scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1240" y="640" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- arrows linking the rows -->
        <mxCell id="ax-1" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-trigger" target="s-precheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-2" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-precheck" target="s-universe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-3" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-universe" target="s-data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-4" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-data" target="s-signal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-5" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666" edge="1" parent="1" source="s-signal" target="s-llm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-6" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-llm" target="s-blacklist"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-7" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-blacklist" target="s-risk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-8" style="endArrow=classic;html=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;strokeColor=#666" edge="1" parent="1" source="s-risk" target="s-broker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-9" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-broker" target="s-size"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-10" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-size" target="s-place"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ax-11" style="endArrow=classic;html=1;strokeColor=#666" edge="1" parent="1" source="s-place" target="s-write"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="footer-5" value="Color key: blue = pre-flight · yellow = LLM/learning gates · green = execution · red = exit checks · purple = user-facing surfaces" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="1400" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


  <!-- ═══════════════════════════════════════════════════════════════════
       PAGE 6 — Crypto Bot Detailed Flow
       ═══════════════════════════════════════════════════════════════════ -->
  <diagram id="crypto-bot" name="6. Crypto Bot — Detailed">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" pageWidth="1500" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="cb-title" value="Crypto Bot — Scalp + Swing on BloFin (paper)" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cb-sub" value="crypto_bot/bot_engine.py · trade_mode = scalp | swing | hybrid · scan_interval default 300s" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1420" height="20" as="geometry"/>
        </mxCell>

        <!-- Inputs -->
        <mxCell id="cb-inputs" value="INPUTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="380" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="cb-i1" value="selected_coins (bot_config)&#10;BTC-USDT · ETH-USDT · SOL · DOGE&#10;AVAX · DOT · LINK · ATOM · SUI · LTC&#10;(MATIC removed Apr 2026, delisted)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cb-i2" value="yfinance OHLCV&#10;daily for swing (period=3mo)&#10;hourly for scalp&#10;dropna() before calculate_indicators" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cb-i3" value="market_sensor (regime check)&#10;BTC trend / ETH dominance / VIX&#10;Returns: BULLISH / NEUTRAL / CAUTION / DANGER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cb-i4" value="_get_adaptive_params()&#10;14-day rolling stats per strategy&#10;blacklisted_strategies / hot_strategies&#10;cautious_coins / position_scale / min_confidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="340" height="70" as="geometry"/>
        </mxCell>

        <!-- Strategies -->
        <mxCell id="cb-strats" value="9 SIGNAL STRATEGIES (in _generate_signal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="600" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s1" value="1. macd_cross&#10;MACD bullish/bearish crossover + RSI confirm + price/EMA20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="560" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s2" value="2. ema_trend (PERMANENTLY BLACKLISTED — 9.8% WR over 51 trades)&#10;SMA8/EMA20 crossover + RSI + MACD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;dashed=1" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="560" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s3" value="3. rsi_reversion&#10;RSI overbought (&gt;70) + MACD turn down + below SMA8 → SELL&#10;RSI oversold (&lt;30) + MACD turn up + above SMA8 → BUY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="220" width="560" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s4" value="4. momentum&#10;Price &gt; SMA50 + volume surge (rel_vol &gt; 1.5x) + RSI in 50-70 zone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="285" width="560" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s5" value="5. bb_reversion (Bollinger Bands mean reversion)&#10;Price touches BB lower + RSI&lt;35 + MACD turning up → BUY (or symmetric SELL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="335" width="560" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s6" value="6. grid_reversion&#10;Price 4x ATR below/above SMA50 in established trend (uptrend pullback / downtrend rally)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="385" width="560" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s7" value="7. trend_dca&#10;Pullback to EMA20 in uptrend (SMA50&gt;200) → BUY · rally to EMA20 in downtrend → SELL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="435" width="560" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s8" value="8. doji_reversal&#10;Doji candle pattern + RSI + price/EMA20 + prior candle direction confirms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="485" width="560" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s9" value="9. pump_on_close (volume + body + close-position)&#10;Vol surge (&gt;2x) + large body + close in upper 25% + RSI + above SMA50 → BUY breakout&#10;Or: dump_on_close — symmetric SELL pattern" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="535" width="560" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cb-s10" value="Plus 4 SWING strategies on daily TF (when trade_mode=swing|hybrid):&#10;swing_vcp · swing_htf · swing_breakout · swing_trend (max 3 swing positions concurrent)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="600" width="560" height="42" as="geometry"/>
        </mxCell>

        <!-- Validators -->
        <mxCell id="cb-val" value="VALIDATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1060" y="90" width="400" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="cb-v1" value="crypto_validator.validate_setup()&#10;3 parallel calls (ThreadPoolExecutor):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cb-v2" value="• Ollama (local) llama3.1:8b&#10;  Sentiment scoring · primary fallback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1080" y="170" width="360" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-v3" value="• OpenRouter LLM_BOT_SENTIMENT (Gemini Flash)&#10;  TIMEOUT FALLBACK = 0.25 conf (was 0.5 — penalized Apr 2026)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1080" y="220" width="360" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-v4" value="• OpenRouter LLM_BOT_RISK (DeepSeek)&#10;  R/R · stop placement · downside" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1080" y="270" width="360" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cb-v5" value="Consensus: majority vote (2 of 3)&#10;PAPER-TRADE BIASED — defaults to APPROVE on ambiguity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1080" y="320" width="360" height="50" as="geometry"/>
        </mxCell>

        <!-- Risk gates -->
        <mxCell id="cb-risk" value="RISK GATES (RiskManager.can_open_position)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1060" y="400" width="400" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="cb-r-list" value="• kill_switch active? → reject&#10;• daily P&amp;L &lt;= -daily_loss_limit ($500)?&#10;  → activate kill_switch + reject&#10;• max_open_positions reached (default 6)?&#10;• already holding ticker?&#10;• confidence &lt; min_confidence (adaptive 0.40-0.55)?&#10;• regime = DANGER → reject all entries&#10;• regime = CAUTION → buy/sell only on top conf&#10;• cautious_coin (recent &gt;5 losses) → 70% size&#10;• strategy in blacklisted_strategies → reject" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1080" y="430" width="360" height="190" as="geometry"/>
        </mxCell>

        <!-- Position sizing -->
        <mxCell id="cb-size" value="POSITION SIZING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="380" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="cb-size-text" value="base_size_usd = equity × max_position_pct / 100&#10;× position_scale (adaptive 0.7-1.0, never &gt; 1)&#10;× cautious_coin_factor (0.7 if flagged)&#10;× hot_strategy_bonus (1.1 if flagged)&#10;&#10;contracts = base_size_usd / contract_size&#10;leverage = config (default 1x demo)&#10;&#10;Hot strategies get +10% size; cold get -30%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="340" height="160" as="geometry"/>
        </mxCell>

        <!-- Exit chain -->
        <mxCell id="cb-exit" value="EXIT CHAIN (every cycle, before scanning new entries)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1420" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="cb-e1" value="Sanity guard&#10;|mark/entry-1| &gt; 1.0&#10;→ skip close&#10;(yfinance bad-tick protection)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="685" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cb-e2" value="Stop-loss / TP&#10;ATR-based stops · 4× ATR target&#10;Trailing stop: 50% retrace from TP if pnl &gt; 0.8%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="300" y="685" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cb-e3" value="48h hard cap&#10;regardless of P&amp;L&#10;(prevents capital lockup —&#10;was unbounded before Apr 2026)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="540" y="685" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cb-e4" value="Time exits (data-driven)&#10;≥8h underwater (&lt;-0.3%) → close&#10;≥16h flat (|pnl|&lt;0.5%) → close&#10;Swing: 14d max" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="780" y="685" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cb-e5" value="Manual close&#10;User clicks Close button&#10;(per-trade UI control)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1020" y="685" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cb-e6" value="On close → re-entry watchlist&#10;losers (&lt;-2%) → eligible_reentry=False&#10;winners → eligible if not knife&#10;3-day window for re-buy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1260" y="685" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Self-learning -->
        <mxCell id="cb-learn" value="SELF-LEARNING LOOP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="cb-l1" value="Strategy blacklist (auto)&#10;n ≥ 10 trades AND WR &lt; 25% AND net &lt; 0&#10;→ skip future signals from this strategy&#10;Permanent: ema_trend (audited Apr 2026)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="935" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb-l2" value="Strategy hot list&#10;n ≥ 8 trades AND WR &gt; 55% AND net &gt; 0&#10;→ +10% position size · prioritize signals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="935" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb-l3" value="Cautious coins&#10;5+ losses, net negative&#10;→ position size × 0.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="740" y="935" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb-l4" value="Adaptive confidence threshold&#10;WR &lt; 35% → 0.55 (high bar)&#10;WR 35-50% → 0.45&#10;WR &gt; 50% → 0.40&#10;14-day rolling window" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1080" y="935" width="360" height="100" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


  <!-- ═══════════════════════════════════════════════════════════════════
       PAGE 7 — Stock Bot Detailed Flow
