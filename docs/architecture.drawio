        <mxCell id="re-4" value="1:N" style="endArrow=classic;html=1;startArrow=classicThin;strokeColor=#666" edge="1" parent="1" source="ent-user" target="ent-cfg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re-5" value="1:N" style="endArrow=classic;html=1;startArrow=classicThin;strokeColor=#b85450;strokeWidth=2" edge="1" parent="1" source="ent-user" target="ent-trade"><mxGeometry relative="1" as="geometry"/></mxCell>
