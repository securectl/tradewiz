        <mxCell id="an-p7" value="3g. detect_breakout_status()&#10;Multi-candle confirmation:&#10;• 3 closes above breakout&#10;• Volume ≥ 1.5× MA(10)&#10;• ADR% within normal range&#10;States: PENDING / BREAKOUT / FAILED / CONSOLIDATING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1120" y="595" width="320" height="100" as="geometry"/>
        </mxCell>

