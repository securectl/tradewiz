          <mxGeometry x="40" y="90" width="380" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="sb-i1" value="stock_selected_stocks (bot_config)&#10;User-curated · default AAPL/TSLA/&#10;NVDA/MSFT/GOOGL/AMD/SPY/QQQ&#10;+ stock_custom_tickers (DXYZ, SLV, GLD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="340" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sb-i2" value="yfinance daily OHLCV&#10;period=1y · indicators: RSI/MACD/EMA/SMA/ATR/ADR%&#10;Volume + relative volume" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="195" width="340" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sb-i3" value="VIX regime gate (bull / bear)&#10;BULL + RSI&gt;70 → skip (too late)&#10;BEAR + low conf → skip&#10;Strong BUY (rel_vol&gt;2 + RSI 50-70) bypass" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sb-i4" value="stock_extended_hours flag&#10;PDT check (Pattern Day Trader)&#10;Market hours gate (9:30-16:00 ET)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="325" width="340" height="40" as="geometry"/>
        </mxCell>

        <!-- Strategies -->
        <mxCell id="sb-strats" value="SIGNAL STRATEGIES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="600" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="sb-st1" value="SCALP strategies (1d candles, hold &lt;14d)&#10;macd_cross · rsi_reversion · momentum · bb_reversion · grid · doji · pump-on-close&#10;(same family as crypto bot, applied to stocks)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sb-st2" value="SWING strategies (when stock_trade_mode=swing|hybrid)&#10;swing_vcp — volatility contraction near 52w high&#10;swing_htf — high tight flag (30%+ run, &lt;15% pullback)&#10;swing_breakout — &gt; 20-day high + 1.5× rel-vol&#10;swing_trend — pullback to rising 50 EMA in uptrend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="190" width="560" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sb-st3" value="Sizing override for swing trades&#10;25% of equity (vs base max_position_pct)&#10;Max 3 concurrent swing positions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="280" width="560" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sb-st4" value="direction_bias = long_only by default for stock bot&#10;(crypto bot is direction_bias=both)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="335" width="560" height="30" as="geometry"/>
        </mxCell>

        <!-- Validation -->
        <mxCell id="sb-val" value="VALIDATION (stock_validator.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1060" y="90" width="400" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="sb-v-text" value="2 OpenRouter validators in parallel (90s timeout each):&#10;• LLM_BOT_SENTIMENT (Gemini Flash)&#10;  Reads: news + social + recent price action&#10;  Returns {execute, confidence, reasoning}&#10;• LLM_BOT_RISK (DeepSeek)&#10;  Reads: setup details + R/R + downside&#10;&#10;Timeout fallback = 0.25 confidence (penalized)&#10;Consensus: majority vote (2 of 2 needed)&#10;PAPER-TRADE BIASED — approves on ambiguity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="360" height="240" as="geometry"/>
        </mxCell>

        <!-- Broker -->
        <mxCell id="sb-broker" value="BROKER LAYER (per-user keys via user_api_keys, encrypted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1420" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="sb-b1" value="stock_broker config&#10;'alpaca' OR 'webull'&#10;(per-user override available)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sb-b2" value="AlpacaClient (paper-py SDK)&#10;ALPACA_API_KEY / ALPACA_SECRET_KEY&#10;Forces paper=True (CLAUDE.md rule)&#10;Stock bot does NOT honor cb_mode='live'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sb-b3" value="WebullClient (sandbox SDK)&#10;WEBULL_APP_KEY / APP_SECRET / ACCOUNT_ID&#10;Sandbox-only · no live mode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="660" y="420" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sb-b4" value="get_balance() returns:&#10;{total_equity, available, unrealized_pnl}&#10;equity drives sizing math (whole shares only)&#10;FRACTIONAL SHARES NOT YET WIRED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1000" y="420" width="440" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sb-b5" value="Position sizing&#10;target_usd = equity × stock_max_position_pct/100 × adaptive_scale&#10;shares = max(1, int(target_usd / price))&#10;⚠ Small accounts: 1 share of $400 stock requires &gt;$400 equity. With $50 equity, sizing returns 0 → trade blocked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="1380" height="50" as="geometry"/>
        </mxCell>

        <!-- Risk + exits -->
        <mxCell id="sb-risk" value="RISK GATES (StockRiskManager.can_open_position)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="700" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="sb-r-text" value="• stock_kill_switch active? → reject all&#10;• daily P&amp;L &lt; -stock_daily_loss_limit ($500)? → kill switch ON, reject&#10;• max_open_positions reached (default 8)?&#10;• stock_max_daily_trades reached?&#10;• PDT pattern: more than 3 day-trades in 5 days on cash &lt; $25K → reject&#10;• outside market hours (or stock_extended_hours not set)?&#10;• already holding ticker?&#10;• Sanity guard: |mark/entry-1| &gt; 1.0 (auto + manual close)&#10;• can_afford(price): shares &gt;= 1 (whole-share constraint)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="660" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="sb-exit" value="EXIT CHAIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="760" y="590" width="700" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="sb-x-text" value="0. Sanity guard (|mark/entry-1| &gt; 1.0) → skip close&#10;1. Stop-loss / hard_stop_pct (default 8%)&#10;2. Take-profit / take_profit_pct (default 25% for swing, 5% scalp)&#10;3. RSI overbought (RSI &gt; 60 + profit &gt; 0.5%) — lock-in&#10;4. Trailing stop: 50% retrace from TP if pnl &gt; 0.5%&#10;5. 48h hard hold cap (force-close regardless of P&amp;L)&#10;6. Swing: 14-day max hold&#10;7. Scalp: 24h stale exit if |pnl| &lt; 0.3%&#10;8. Market close gate: pending exits at 16:00 ET&#10;9. Manual close — Close button per trade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="780" y="620" width="660" height="200" as="geometry"/>
        </mxCell>

        <!-- Self-learning -->
        <mxCell id="sb-learn" value="SELF-LEARNING (same as crypto bot, scoped to asset_type='stock')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="sb-learn-text" value="Strategy blacklist (n≥10, WR&lt;25%, net&lt;0) · hot list (n≥8, WR&gt;55%, net&gt;0) · cautious tickers · adaptive confidence threshold&#10;14-day rolling window from bot_trades WHERE asset_type='stock'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="1380" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


  <!-- ═══════════════════════════════════════════════════════════════════
       PAGE 8 — Claude Bot Detailed Flow
       ═══════════════════════════════════════════════════════════════════ -->
  <diagram id="claude-bot" name="8. Claude Bot — Detailed">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" pageWidth="1500" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="cb2-title" value="Claude Bot — Scalp + Rotate (screener-driven, paper or LIVE)" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-sub" value="claude_bot/bot_engine.py · cb_broker = alpaca | webull · cb_mode = paper | live · cb_scan_interval default 300s" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1420" height="20" as="geometry"/>
        </mxCell>

        <!-- Candidate sourcing -->
        <mxCell id="cb2-cand" value="CANDIDATE SOURCING (_get_candidates, no static watchlist)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="700" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-c1" value="1. oversold_daily table (persistent oversold tracker)&#10;Multi-day rsi_avg below threshold&#10;AI confidence ≥ 65 (cb_min_confidence)&#10;entry_style = 'reversal'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-c2" value="2. screener gainers (top 15)&#10;Recent momentum names · entry_style='momentum'&#10;Vetted by screener LLM before reaching bot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-c3" value="3. Re-entry watchlist (bot_reentry_watch)&#10;Recently-closed winners eligible_reentry=True&#10;3-day window · re-entry size factor 0.5 · max 2 attempts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="660" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-c4" value="No fixed watchlist — bot follows screener output dynamically.&#10;Universe is whatever the screener surfaces today." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="660" height="35" as="geometry"/>
        </mxCell>

        <!-- _evaluate logic -->
        <mxCell id="cb2-eval" value="_evaluate(ticker, entry_style, composite_rsi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="760" y="90" width="700" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-e1" value="Computes: RSI(14) · SMA20 · SMA50 · ATR14&#10;daily rsi (RSI on 1d candles) · composite RSI (multi-TF average)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="660" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-e2" value="REVERSAL gate (oversold candidates):&#10;• composite_rsi &lt; 40 (or daily RSI &lt; 35 if no composite)&#10;• daily RSI &lt; 40&#10;• Price within 8% above SMA20 (filters falling knives)&#10;→ BUY signal · entry_style='reversal'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="780" y="170" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-e3" value="MOMENTUM gate (gainers):&#10;• RSI between 45 and 72 (not stretched)&#10;• Price &gt; SMA20&#10;• SMA20 &gt;= SMA50 × 0.99 (uptrend)&#10;→ BUY signal · entry_style='momentum'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1120" y="170" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-e4" value="Both gates failed → SKIP (no signal)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="780" y="280" width="660" height="25" as="geometry"/>
        </mxCell>

        <!-- LLM gate -->
        <mxCell id="cb2-llm" value="LLM VALIDATION GATE (_llm_validate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1420" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-l1" value="Model resolution order:&#10;OPENROUTER_MODEL_GATING&#10;  → OPENROUTER_MODEL_RESEARCH&#10;  → deepseek/deepseek-chat (fallback)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-l2" value="Prompt input:&#10;ticker · entry_style · price · indicators · screener context · fundamentals · recent news&#10;Asks: BUY / SKIP + confidence + reasoning&#10;Requires LLM confidence ≥ 60% to approve" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="360" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-l3" value="Fallback: rule-based logic if API unavailable&#10;Returns approval if rule gates passed (paper-trade biased)&#10;ML cache: per-ticker decision cached 5 min so retries are cheap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="800" y="360" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-l4" value="On approve: signal becomes BUY&#10;On reject: row written to bot_log&#10;(level=info, source='claude_bot')&#10;NO journal_entries (cleaned Apr 2026)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1140" y="360" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-l5" value="Models — see Page 2 for the full LLM map" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="1380" height="30" as="geometry"/>
        </mxCell>

        <!-- Risk gates -->
        <mxCell id="cb2-risk" value="RISK GATES (_open_trade)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="700" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-r-text" value="1. cb_kill_switch active? → BLOCK&#10;2. Daily P&amp;L ≤ -cb_daily_loss_limit ($25 for $50 account)?&#10;     → activate kill switch, BLOCK&#10;3. _open_count(user_id) ≥ cb_max_positions (5)? → BLOCK&#10;4. _has_position(user_id, ticker)? → BLOCK (no double-stack)&#10;5. price ≤ 0? → BLOCK&#10;6. equity from broker.get_balance() = 0? → log warn, skip sizing&#10;7. shares = max(1, int(equity × cb_max_position_pct / 100 / price))&#10;     ≥ 1 share required (no fractional yet)&#10;&#10;Live mode (cb_mode='live') uses real Alpaca account&#10;same gates apply — kill switch is not bypassed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="660" height="200" as="geometry"/>
        </mxCell>

        <!-- Exit chain -->
        <mxCell id="cb2-exit" value="EXIT CHAIN (_check_exits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="760" y="530" width="700" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-x-text" value="0. 48h hard hold cap (Apr 2026) — force close + log&#10;1. Hard stop ≤ -cb_hard_stop_pct (8%) — no re-entry&#10;2. Take-profit ≥ cb_take_profit_pct (5%) — eligible_reentry=True&#10;3. Scalp stop ≤ -cb_scalp_stop_pct (2%) — eligible re-entry&#10;4. RSI &gt; 60 AND pnl &gt; 0.5% — lock-in (eligible re-entry)&#10;5. Implausible price guard: |mark/entry-1| &gt; 1.0 → REJECT close&#10;     (PRTA $11.51 → $433.47 phantom blocked Apr 2026)&#10;6. Manual close from UI — same guard applies&#10;7. On close → may add to bot_reentry_watch for stabilization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="780" y="560" width="660" height="200" as="geometry"/>
        </mxCell>

        <!-- Re-entry logic -->
        <mxCell id="cb2-reentry" value="RE-ENTRY MECHANISM (the &quot;rotate&quot; in scalp+rotate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1420" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-rt1" value="On close, _add_reentry() writes to bot_reentry_watch:&#10;ticker · exit_price · exit_pnl_pct · exit_reason · status='watching'&#10;TTL: cb_reentry_window_days (default 3 days)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="440" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-rt2" value="_check_reentries(user_id, regime) every cycle:&#10;Stabilization rule:&#10;• last close ≥ exit_price × 0.99&#10;• AND last bar bullish (close &gt; open)&#10;→ re-open at cb_reentry_size_factor × normal size (default 0.5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="820" width="440" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cb2-rt3" value="Caps:&#10;• cb_reentry_max_attempts (default 2 per ticker)&#10;• Watchlist expires after cb_reentry_window_days (3)&#10;• Hard-stop closes do NOT add to re-entry list&#10;Surfaced in UI: re-entry watchlist panel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="980" y="820" width="460" height="100" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


  <!-- ═══════════════════════════════════════════════════════════════════
       PAGE 9 — Watchdog Bot Detailed Flow
       ═══════════════════════════════════════════════════════════════════ -->
  <diagram id="watchdog-bot" name="9. Watchdog — Detailed">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" pageWidth="1500" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="wd-title" value="Watchdog — Aggressive Day Trader (low/mid-cap focus)" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="wd-sub" value="features/watchdog/engine.py · BUY 9:30-11:00 ET only · EOD force-close 3:55 PM ET · daily_goal $1000" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1420" height="20" as="geometry"/>
        </mxCell>

        <!-- Regime score (3 axes) -->
        <mxCell id="wd-regime" value="REGIME SCORE — get_regime() composite (0-100)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1420" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="wd-r1" value="AXIS 1 — Market Structure (45% weight)&#10;_score_market_structure()&#10;• SPY 5d / 20d trend slope&#10;• QQQ trend confirmation&#10;• VIX level (calm vs spike)&#10;Output: 0-100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="380" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="wd-r2" value="AXIS 2 — Sentiment (25% weight)&#10;_score_sentiment()&#10;• Trump mood RSS (Truth Social tone)&#10;• Social/news sentiment proxy&#10;• News fetcher 24h headlines&#10;Output: 0-100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="380" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="wd-r3" value="AXIS 3 — Technical (30% weight)&#10;_score_technical(spy_df)&#10;• RSI(14) on SPY · MACD signal&#10;• 20/50/200 SMA alignment&#10;• ADR% / volatility&#10;Output: 0-100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="860" y="120" width="380" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="wd-r4" value="Composite&#10;= 0.45·M + 0.25·S + 0.30·T&#10;&#10;Bins:&#10;75-100 RISK-ON&#10;50-74  NEUTRAL&#10;25-49  RISK-OFF&#10;0-24   DANGER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1260" y="120" width="180" height="160" as="geometry"/>
        </mxCell>

        <!-- Universe -->
        <mxCell id="wd-univ" value="UNIVERSE BUILD (Apr 2026 spec — low/mid-cap focused)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1420" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="wd-u1" value="1. wd_watchlist (user-config)&#10;Default: LOWCAP_TICKERS + MIDCAP_TICKERS (~180 tickers from screener.py)&#10;User can override per-user" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="440" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="wd-u2" value="2. _get_screener_candidates() (screener categories)&#10;{lowcap, midcap, gainers, ai, oversold} × confidence ≥ 70&#10;LARGECAP REMOVED (Apr 2026) — use overlay instead" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="440" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="wd-u3" value="3. Persistent picks _get_persistent_lowmidcap_picks(min_days=2)&#10;Tickers seen in ≥2 distinct scan_dates last 7 days&#10;Skip FALLING KNIFE / AVOID verdicts&#10;Confidence boost: +5/+10/+15 by days persistence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="980" y="340" width="460" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="wd-u4" value="4. Large-cap overlay _get_largecap_breakouts() (1h cache)&#10;Runs qullamaggie_scan(LARGECAP_TICKERS) → keeps tickers with score ≥ 7 (max 5)&#10;Only path for large-caps to reach the bot — no permissive admission" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="415" width="1380" height="60" as="geometry"/>
        </mxCell>

        <!-- Signal generation -->
        <mxCell id="wd-sig" value="SIGNAL DETECTION (_detect_swing_setup) — 5 patterns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1420" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="wd-s1" value="0. RSI Reversal&#10;RSI &lt; 30 + within 6%&#10;of EMA20 (no falling&#10;knife) → +5% TP,&#10;-1.5×ATR SL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="260" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="wd-s2" value="1. VCP&#10;Volatility&#10;contraction&#10;Range tightening + volume&#10;declining&#10;Confidence 75&#10;TP: +3×ATR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="340" y="540" width="220" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="wd-s3" value="2. HTF (High Tight Flag)&#10;30%+ run from low&#10;Pullback &lt; 15% from high&#10;Tight consolidation&#10;Confidence 72&#10;TP: 3×ATR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="580" y="540" width="220" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="wd-s4" value="3. Breakout&#10;Price &gt; 20-day high&#10;Volume &gt; 1.5× avg&#10;Confidence 70&#10;SL: gap-fill or&#10;ATR-based" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="540" width="220" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="wd-s5" value="4. Earnings Gap&#10;5%+ price gap&#10;Volume 2× avg&#10;Holding gap level&#10;Confidence 68&#10;Entry on retest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1060" y="540" width="220" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="wd-sx" value="Regime overlay&#10;DANGER → BUY→HEDGE,&#10;conf -30&#10;RISK-OFF → conf -15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="1300" y="540" width="140" height="170" as="geometry"/>
        </mxCell>

        <!-- LLM vet -->
        <mxCell id="wd-llm" value="LLM PRE-TRADE VETTING (_llm_vet_watchdog_candidate, parallel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="wd-l-text" value="ThreadPoolExecutor(max_workers=5) — pending list of (cand, setup) pairs vetted in parallel&#10;Model: OPENROUTER_MODEL_RESEARCH (Claude Sonnet by default)&#10;Input: setup details + screener verdict + regime + recent news&#10;Returns approve/skip · cached so repeat scans don't re-cost · 30s pool timeout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1380" height="60" as="geometry"/>
        </mxCell>

        <!-- Time + risk + exit -->
        <mxCell id="wd-time" value="TIME GATES (US/Eastern)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="450" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="wd-t-text" value="• Buy window: 9:30 AM – 11:00 AM ET&#10;  Outside → exits run, no new entries&#10;• EOD force-close: 3:55 PM ET (weekday)&#10;  All open positions close regardless of P&amp;L&#10;• 1-day stale exit (defense in depth)&#10;  Catches positions if bot was stopped over close&#10;&#10;Day-trader rule: NEVER hold overnight&#10;Updated Apr 2026 (was 9:30-10:30 CST + 14d swing)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="410" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="wd-risk" value="RISK GATES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="510" y="870" width="450" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="wd-rk-text" value="• wd_kill_switch active? → block all&#10;• Daily P&amp;L &lt; -wd_daily_loss_limit ($1000)&#10;  → kill switch ON, block&#10;• wd_max_positions reached (default 3)?&#10;• wd_min_confidence (default 65) gate&#10;• max_position_pct (default 15%)&#10;• Max 2 new BUYs per cycle&#10;• Confidence floor adjusted by regime&#10;• Already-holding ticker → skip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="530" y="900" width="410" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="wd-exit" value="EXIT CHAIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="980" y="870" width="480" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="wd-x-text" value="0. EOD 3:55 PM ET → force-close all (highest priority)&#10;1. Stop-loss (SL from setup)&#10;2. Quick-trade profit exit:&#10;   • ≥ 7% — hard cap (don't get greedy)&#10;   • ≥ 4% — solid quick profit&#10;3. RSI overbought (RSI &gt; 60 + pnl &gt; 0.5%) — lock in&#10;4. Take-profit (original TP level)&#10;5. 1-day stale exit (defense in depth)&#10;6. Sanity guard: |mark/entry-1| &gt; 1.0 → reject" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1000" y="900" width="440" height="160" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


  <!-- ═══════════════════════════════════════════════════════════════════
