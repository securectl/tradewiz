# ═══════════════════════════════════════════════════════════════
# AI Stock Analyst — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# OpenRouter LLM Configuration
# Get your API key at: https://openrouter.ai/keys
# ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model 1: Research & Fundamentals
LLM_RESEARCH=anthropic/claude-sonnet-4-6
# Model 2: Pattern Recognition & Chart Analysis
LLM_PATTERN=google/gemini-2.5-pro-preview
# Model 3: Price Prediction & Risk Assessment
LLM_PREDICTION=deepseek/deepseek-chat-v3-0324

# Fast mode: cheaper/faster models (0=OFF, 1=ON)
LLM_FAST_MODE=0
LLM_RESEARCH_FAST=google/gemini-2.5-flash

# Screener model
LLM_SCREENER=google/gemini-2.5-flash

# Supervisor / Judge LLM (4th gate — blocks bad trades/analyses)
# Leave empty to disable. Set to a model ID to enable.
# LLM_SUPERVISOR=anthropic/claude-sonnet-4-6

# LLM settings
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ───────────────────────────────────────────────────────────────
# Bot LLM Models (OpenRouter — trade validation)
# ───────────────────────────────────────────────────────────────
LLM_BOT_SENTIMENT=google/gemini-2.5-flash
LLM_BOT_RISK=deepseek/deepseek-chat-v3-0324

# Ollama Cloud — gating / limiter LLM tier (https://ollama.com, paid subscription)
# Used by: crypto/stock validator gate-1, claude_gating, watchdog_gating.
# Get OLLAMA_API_KEY from ollama.com settings. No local daemon is supported.
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b

# Market Sensor (pre-scan health check — blocks trades during market crashes)
# Set to 0 to disable
BOT_SENSOR_ENABLED=1

# ───────────────────────────────────────────────────────────────
# Skills LLM Models (Financial Analysis, Equity Research, etc.)
# ───────────────────────────────────────────────────────────────
LLM_SKILL=nvidia/nemotron-3-super-120b-a12b
LLM_SKILL_EARNINGS=anthropic/claude-opus-4-6

# ───────────────────────────────────────────────────────────────
# Congress Trades — Senate Data
# Free API key from https://financialmodelingprep.com/register
# Unlocks actual Senate buy/sell/ticker/amount data (vs news-only fallback)
# ───────────────────────────────────────────────────────────────
FMP_API_KEY=

# ───────────────────────────────────────────────────────────────
# Crypto Trading Bot (BloFin Demo — Paper Trading)
# ───────────────────────────────────────────────────────────────
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=
BLOFIN_DEMO=1

# Bot risk defaults
BOT_MAX_POSITION_PCT=10
BOT_DAILY_LOSS_LIMIT=250
BOT_MAX_OPEN_POSITIONS=3
BOT_SCAN_INTERVAL=300

# ───────────────────────────────────────────────────────────────
# Stock Trading Bot (Alpaca/Webull — Paper Trading)
# ───────────────────────────────────────────────────────────────
# Alpaca (https://app.alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Webull (optional) — Get from https://developer.webull.com
# App Secret expires (1-7 days) — regenerate when needed
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=                   # Optional — auto-detected via API if blank

# ───────────────────────────────────────────────────────────────
# Stripe — Subscription Billing
# https://dashboard.stripe.com/apikeys
# ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create products/prices in Stripe Dashboard, paste price IDs:
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ───────────────────────────────────────────────────────────────
# Auth — Email/Password + Google OAuth2 (optional)
# Google OAuth: https://console.cloud.google.com/apis/credentials
# ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
# Google SSO (optional — email/password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin email — visit /auth/admin-setup after first deploy to set password + TOTP
ADMIN_EMAIL=admin@yourdomain.com

# ───────────────────────────────────────────────────────────────
# Support — Email & Google Form (for locked account / help requests)
# ───────────────────────────────────────────────────────────────
SUPPORT_EMAIL=abdul.khan@securectl.com
# SMTP for sending support emails (Gmail, SendGrid, etc.)
SMTP_HOST=                               # e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                               # e.g. noreply@yourdomain.com
SMTP_PASS=                               # App password (not your regular password)
# Google Form fallback (if SMTP not configured)
# SUPPORT_GOOGLE_FORM_URL=               # e.g. https://docs.google.com/forms/d/.../formResponse

# ───────────────────────────────────────────────────────────────
# Docker / VPS Deployment
# ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
APP_PORT=5000

# ───────────────────────────────────────────────────────────────
# Database (leave blank for SQLite)
# ───────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
